<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.xml</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Versioning -->
    <Version>1.0.0-rc.6</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-rc.6</InformationalVersion>

    <!-- Package Metadata -->
    <PackageId>SYT.Fiskaly</PackageId>
    <Title>SYT Fiskaly SDK</Title>
    <Description>.NET SDK for Fiskaly SIGN DE v2 API - German fiscal compliance (KassenSichV)</Description>
    <Authors>Anatoliy Yermakov</Authors>
    <Company>SYT Open Source Community</Company>
    <PackageProjectUrl>https://github.com/i7aket/SYT.Fiskaly</PackageProjectUrl>
    <RepositoryUrl>https://github.com/i7aket/SYT.Fiskaly</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>fiskaly;sign-de;kassensichv;dotnet;sdk;pos</PackageTags>
    <PackageReleaseNotes>
Release candidate turning "the export is not downloadable yet" into a catchable failure.

Highlights:
- DownloadExportAsync now raises FiskalyExportNotReadyException instead of a bare InvalidOperationException.
  The old type sat outside the FiskalyException hierarchy every caller catches, so an ordinary race - the
  state is read here, immediately before the download, and the export finishes in between - escaped as an
  unhandled exception and surfaced as an HTTP 500 in consuming applications
- the exception carries State, ExportId and the provider's ExceptionCode, plus IsTransient, so a caller can
  tell the two cases apart: PENDING/WORKING becomes downloadable on its own and is worth polling, ERROR never
  does and polling it is an infinite wait
- source-compatible for anyone who catches FiskalyException; only code that catches InvalidOperationException
  specifically around a download needs to change
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SYT.Fiskaly.IntegrationTests" />
    <InternalsVisibleTo Include="SYT.Fiskaly.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
